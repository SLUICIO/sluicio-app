# SPDX-License-Identifier: FSL-1.1-Apache-2.0
# Env for running against YOUR OWN external Postgres + ClickHouse.
# Copy to sluicio.env and fill in. Pass with --env-file sluicio.env.
# Use with docker-compose.registry.external-db.yml (see that file's header).
# Do NOT commit the filled-in copy (sluicio.env is gitignored).

# Registry the Sluicio images are pulled from. The official public images are
# at ghcr.io/sluicio; pin TAG to a version for a release, or leave `latest`.
REGISTRY=ghcr.io
NAMESPACE=sluicio
TAG=latest

# ── Your external Postgres (control-plane DB) ────────────────────────────────
# A single DSN. cell-api applies its migrations here on startup; the database
# ("controlplane" below, but any name works) just needs to exist and be
# reachable with a role that can create tables. Use sslmode=require for a
# managed DB.
POSTGRES_DSN=postgres://user:pass@your-pg-host:5432/controlplane?sslmode=require

# ── Your external ClickHouse (telemetry store) ───────────────────────────────
# Native protocol endpoint (host:9000, or :9440 for TLS). cell-api creates its
# tables in CLICKHOUSE_DATABASE on startup.
CLICKHOUSE_ENDPOINT=your-ch-host:9000
CLICKHOUSE_DATABASE=telemetry
CLICKHOUSE_USERNAME=sluicio
CLICKHOUSE_PASSWORD=change-me-clickhouse

# ── If you only have ONE of the two ──────────────────────────────────────────
# Layer a bundled overlay and set that DB's user/password instead of the
# external vars above. See docker-compose.bundled-postgres.yml /
# docker-compose.bundled-clickhouse.yml. For a bundled Postgres overlay set:
#   POSTGRES_USER=sluicio
#   POSTGRES_PASSWORD=change-me-postgres
# For a bundled ClickHouse overlay set:
#   CLICKHOUSE_USER=sluicio
#   CLICKHOUSE_PASSWORD=change-me-clickhouse

# Public origin users reach Sluicio at (e.g. https://sluicio.acme.com). Used to
# build deep links in background notifications; empty = links omitted.
# Public OTLP ingest origin (e.g. https://ingest.example.com) — authoritative;
# the in-app ingest-URL setting is read-only while this is set.
SLUICIO_INGEST_URL=
SLUICIO_APP_URL=

# Managed mode: leave BOTH unset for an ordinary self-hosted install.
#
# Set SLUICIO_MANAGED=true only when a platform runs this instance on behalf
# of someone else. It changes who owns the instance: no user is its operator
# (the instance-wide settings belong to the platform), the seeded admin gets
# no password at all, and the first user claims the instance with a token
# instead.
#
# SLUICIO_BOOTSTRAP_TOKEN is that token: random, one per instance, and given
# to the owner as a setup link ending in #t=<token>. A managed instance
# without it refuses first-user setup entirely, which is deliberate - an
# instance is reachable before its owner has opened it, and the alternative
# is that whoever finds the address first owns it.
SLUICIO_MANAGED=
SLUICIO_BOOTSTRAP_TOKEN=

# Optional: when the claim token stops working (RFC 3339, e.g.
# 2026-10-03T12:00:00Z). Whoever issues the token owns its lifetime; this is
# the backstop for a setup link that was sent and never used. In managed mode
# a value that cannot be parsed stops the service from starting rather than
# being read as "no expiry" - a typo must not leave a token live for ever.
SLUICIO_BOOTSTRAP_TOKEN_EXPIRES_AT=

# Environment label shown in the top nav (e.g. production, staging). Optional,
# and independent of managed mode: when set it is authoritative, so the in-app
# setting becomes read-only - a deployment that renders the label knows it
# better than anyone signed in.
SLUICIO_ENVIRONMENT=

# Published host ports (defaults shown).
FRONTEND_PORT=8080       # browser / reverse proxy → UI (+ /api proxy)
CELL_API_PORT=8081       # reverse proxy → cell-api /api/*
CELL_INGEST_PORT=4318    # OTLP/HTTP producers → cell-ingest
